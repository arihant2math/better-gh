# Better GitHub configuration (environment file).
# Used by deploy/systemd/bgh.service (/etc/bgh/bgh.env) and by
# `docker run --env-file` (which takes values literally: no quotes there).
# Every variable is optional; defaults shown. Quote values with spaces.
# Full reference: docs/SELF_HOSTING.md#configuration-reference

# --- required in production ---------------------------------------------------
# External URL, exactly as users reach it (scheme + host [+ port], no trailing
# slash). Every generated link (API *_url fields, clone URLs, emails) uses it.
BGH_BASE_URL=https://git.example.com
DATABASE_URL=postgres://bgh:CHANGE-ME@127.0.0.1/bgh
REDIS_URL=redis://127.0.0.1/

# --- network --------------------------------------------------------------------
# Behind a reverse proxy on the same host, listen on loopback only.
BGH_LISTEN=127.0.0.1:3000
# Port advertised in ssh:// clone URLs.
#BGH_SSH_PORT=2222
#BGH_SSH_ENABLED=true

# --- storage --------------------------------------------------------------------
# Git repositories live in $BGH_DATA_DIR/repos, uploads in $BGH_DATA_DIR/files.
# (The systemd unit sets this to /var/lib/bgh.)
#BGH_DATA_DIR=./data
# Only needed for binaries built without the `embed-web` feature.
#BGH_WEB_DIR=web/dist

# --- behaviour ------------------------------------------------------------------
#BGH_SITE_NAME="Better GitHub"
#BGH_SIGNUP_ENABLED=true
#BGH_SESSION_TTL_DAYS=30
#BGH_JOB_WORKERS=4
#BGH_DB_MAX_CONNECTIONS=20
#BGH_REDIS_PREFIX=bgh:
#BGH_GIT_BIN=git
#BGH_MAX_BLOB_SIZE=10485760

# --- logging --------------------------------------------------------------------
RUST_LOG=info,sqlx=warn
