{
  "name": "bgh-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "vite build && node scripts/size-check.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.sw.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-check.mjs",
    "analyze": "vite build && node scripts/size-check.mjs --verbose"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@primer/octicons-react": "^19.38.0",
    "@tanstack/react-virtual": "^3.14.13",
    "dompurify": "^3.4.16",
    "idb": "^8.0.3",
    "marked": "^18.0.14",
    "mermaid": "^11.17.2",
    "mobx": "^7.0.6",
    "mobx-react-lite": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "temml": "^0.13.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "gemoji": "^8.1.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.3"
  },
  "sideEffects": [
    "*.css",
    "./src/main.tsx",
    "./src/test/setup.ts"
  ]
}
